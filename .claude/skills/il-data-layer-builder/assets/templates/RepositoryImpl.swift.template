import Foundation

/// Data-layer implementation of `IL{{Feature}}Repository`.
///
/// This is the **only** place a DTO may exist above `NetworkService`: it converts at the boundary
/// (`IL{{Feature}}Mapper`) and hands Entities upward
/// (`references/data_layer_architecture.md` §1). It owns the Endpoint and the Mapper; nothing else
/// does.
final class IL{{Feature}}RepositoryImpl: IL{{Feature}}Repository {

    private let networkService: NetworkService

    init(networkService: NetworkService) {
        self.networkService = networkService
    }

    func {{actionName}}(_ entity: IL{{Feature}}Entity) async throws {
        let dto = IL{{Feature}}Mapper.toDTO(entity)

        do {
            // Use the `responseType:` overload only when the success response carries something
            // the app actually needs. For a 202/204-style response, use the no-body overload —
            // do not invent a decodable type just to satisfy the first one
            // (`references/data_layer_architecture.md` §5).
            try await networkService.request(endpoint: {{Action}}Endpoint(
                {{field}}: dto.{{field}}
            ))
        } catch let error as NetworkError {
            // Never let a NetworkError escape upward — map it to a feature-specific case so the
            // ViewModel's `catch IL{{Feature}}Error.xxx` branches keep working unchanged
            // (`references/error_mapping.md`).
            throw IL{{Feature}}Error.from(error)
        }
    }

    // MARK: - Response-carrying variant
    //
    // When the response has a body worth decoding, the shape is:
    //
    // func {{actionName}}(_ entity: IL{{Feature}}Entity) async throws -> IL{{Feature}}Entity {
    //     let dto = IL{{Feature}}Mapper.toDTO(entity)
    //     do {
    //         let response = try await networkService.request(
    //             endpoint: {{Action}}Endpoint({{field}}: dto.{{field}}),
    //             responseType: {{Action}}ResponseDTO.self
    //         )
    //         return IL{{Feature}}Mapper.toDomain(response)
    //     } catch let error as NetworkError {
    //         throw IL{{Feature}}Error.from(error)
    //     }
    // }
}

