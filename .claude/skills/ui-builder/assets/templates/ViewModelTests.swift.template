import XCTest
import Combine
@testable import InnerLamp

final class IL{{Feature}}ViewModelTests: XCTestCase {

    private var mockUseCase: MockIL{{Feature}}UseCase!
    private var sut: IL{{Feature}}ViewModel!
    private var cancellables: Set<AnyCancellable>!

    override func setUp() {
        super.setUp()
        mockUseCase = MockIL{{Feature}}UseCase()
        sut = IL{{Feature}}ViewModel(useCase: mockUseCase)
        cancellables = []
    }

    override func tearDown() {
        cancellables = nil
        sut = nil
        mockUseCase = nil
        super.tearDown()
    }

    func test_initialState_matchesUseCaseDefault() {
        let viewDidLoadSubject = PassthroughSubject<Void, Never>()
        let output = sut.transform(input: .init(viewDidLoad: viewDidLoadSubject.eraseToAnyPublisher()))

        var receivedState: IL{{Feature}}StateModel?
        output.state
            .sink { state in
                if case .success(let model) = state { receivedState = model }
            }
            .store(in: &cancellables)

        viewDidLoadSubject.send(())

        XCTAssertNotNil(receivedState)
        // TODO: assert the real default fields, e.g.:
        // XCTAssertEqual(receivedState?.someField, expectedDefault)
    }

