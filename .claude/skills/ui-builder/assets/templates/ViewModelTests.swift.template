// MARK: - Mock IL{{Feature}}UseCase
final class MockIL{{Feature}}UseCase: IL{{Feature}}UseCase {
    var getInitialStateCalled = false
    // TODO: add one `*Called` flag (and captured-args property, if relevant) per method on
