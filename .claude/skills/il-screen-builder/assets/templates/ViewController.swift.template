import UIKit
import Combine

final class IL{{Feature}}ViewController: BaseViewController {

    // MARK: - Properties
    private let viewModel: IL{{Feature}}ViewModel
    private var cancellables = Set<AnyCancellable>()
    private let viewDidLoadSubject = PassthroughSubject<Void, Never>()
    // TODO: add one Subject per Input trigger declared on IL{{Feature}}ViewModel.Input, e.g.:
    // private let someActionTappedSubject = PassthroughSubject<Void, Never>()

    // MARK: - UI Elements
    // TODO: declare each subview as `private lazy var` here (configured inline in its
    // initializer closure) — never build it inside setupViews(). Prefer reusable IL*
    // components (ILButton, ILField, ILRow, ILHeaderView, ...) and ILColors/ILTypography/
    // ILMetrics tokens over ad-hoc UIKit primitives. No literal text ("key".localized instead,
    // key added to Resources/Localization/vi.json), no literal font size (ILTypography preset
    // instead), no literal color (ILColors instead) — see references/design_tokens_rules.md.
    //
    // private lazy var titleLabel: UILabel = {
    //     let label = UILabel()
    //     label.font = ILTypography.title
    //     label.textColor = ILColors.ilInk
    //     label.text = "{{featureLower}}.title".localized
    //     return label
    // }()

    // MARK: - Initializer
    init(viewModel: IL{{Feature}}ViewModel) {
        self.viewModel = viewModel
        super.init(nibName: nil, bundle: nil)
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    // MARK: - Setup
    override func setupViews() {
        super.setupViews()
        // TODO: view.addSubview(...) each lazy subview declared above (this is where they
        // first get built, via the lazy init closure), and wire UI action targets to `.send(())`
        // on the matching *Subject declared above, e.g.:
        // someButton.onTap = { [weak self] in self?.someActionTappedSubject.send(()) }
    }

    override func setupConstraints() {
        super.setupConstraints()
        // TODO: Auto Layout constraints.
    }

    override func bindViewModel() {
        super.bindViewModel()

        let input = IL{{Feature}}ViewModel.Input(
            viewDidLoad: viewDidLoadSubject.eraseToAnyPublisher()
            // TODO: pass each *Subject declared above as its matching Input publisher.
        )
        let output = viewModel.transform(input: input)

        output.state
            .receive(on: DispatchQueue.main)
            .sink { [weak self] state in self?.render(state: state) }
            .store(in: &cancellables)

        viewDidLoadSubject.send(())
    }

    // MARK: - Render
    private func render(state: ViewState<IL{{Feature}}StateModel>) {
        switch state {
        case .idle, .loading:
            break
        case .success(let model):
            updateUI(with: model)
        case .failure(let error):
            showError(error.localizedDescription)
        }
    }

    private func updateUI(with model: IL{{Feature}}StateModel) {
        // TODO: apply model to UI elements.
    }
}
