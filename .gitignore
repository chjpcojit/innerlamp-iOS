# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

pb/

# IDEs & Editors
.idea/
.vscode/

# Unit test reports
TEST*.xml

build

# OS generated files
.DS_Store
Thumbs.db

# Go specific (output application binary)
bin/
vendor/

# Go workspace file
go.work
go.work.sum
# Go module files
go.sum

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Xcode build output (derived artifacts — never commit)
build/
DerivedData/

# Sensitive file
*.pem
*.json
# The gRPC Swift 2 proto codegen config is project configuration, not sensitive data — it must
# stay tracked so the build-tool plugin can regenerate stubs on every checkout.
!**/grpc-swift-proto-generator-config.json
*.yaml
*-adminsdk-*.json
*.sh
*.p8
*.txt
*.env
*.bat
.ssh/
.github
vendor

# Claude Code hook runtime state (not config — regenerated on every hook run)
# Keep .claude/settings.json, hooks/, skills/, locked_files.txt tracked:
# they are matched by the *.json / *.sh / *.txt rules above but stay tracked
# because git only ignores untracked files.
.claude/hook_log.jsonl
.claude/*_retry_count
.claude/hook.lock